# PART 1: INPUT PARSING - Anoushka Prabhu

def get_input():
    """Gets user input for FASTA filename."""
    f = input("Enter FASTA file: ")
    return f

def parse(f):
    """Parses FASTA file and returns list of (header, DNA sequence)."""
    try:
        with open(f, 'r') as file:
            lines = file.readlines()
    except FileNotFoundError:
        print(f"Error: File '{f}' not found.")
        return []
    
    seqs = []
    i = 0
    
    while i < len(lines):
        if lines[i].startswith('>'):
            h = lines[i].strip()[1:]
            i += 1
            parts = []
            while i < len(lines) and not lines[i].startswith('>'):
                line = lines[i].strip().upper()
                line = ''.join(line.split())
                if line:
                    parts.append(line)
                i += 1
            dna = ''.join(parts)
            seqs.append((h, dna))
        else:
            i += 1
    
    return seqs

def get_sequences():
    """Retrieves sequences from file."""
    f = get_input()
    seqs = parse(f)
    if not seqs:
        return []
    return seqs

# PART 2: ORF DETECTION - Ashwarya Sharma
def reverse_complement(dna): #Creating Reverse Complement strand
    complement = {'A': 'T', 'T': 'A', 'G': 'C', 'C': 'G'}
    reverse = dna[::-1]

    result = ''
    for letter in reverse:
        if letter in complement:
            result = result + complement[letter]
        else:
            result = result + letter
    
    return result

def orf_frame(dna, start_position, frame_number): #Selecting ORF frame
    orfs = []
    position = start_position
    
    while position <= len(dna) - 3:
        codon = dna[position:position+3]
        
        if codon == 'ATG':
            start = position
            new_position = position + 3
            
            found_stop = False
            while new_position <= len(dna) - 3:
                stop_codon = dna[new_position:new_position+3]
                
                if stop_codon == 'TGA' or stop_codon == 'TAG' or stop_codon == 'TAA':
                    orf_sequence = dna[start:new_position+3]
                    orf_length = len(orf_sequence)
                    pos = start + 1
                    
                    orfs.append((frame_number, pos, orf_length, orf_sequence))
                    position = new_position + 3
                    found_stop = True
                    break
                
                new_position = new_position + 3
            
            if not found_stop:
                position = position + 3
        else:
            position = position + 3
    
    return orfs

def find_orfs(dna): #Find ORFS for all Reading Frames including forward and reverse
    all_orfs = []
    
    for frame in range(3):
        all_orfs.extend(orf_frame(dna, frame, frame + 1))
    
    
    rev_comp = reverse_complement(dna)
    for frame in range(3):
        all_orfs.extend(orf_frame(rev_comp, frame, -(frame + 1)))
    
    return all_orfs

def filtering(orfs, min_length): #Filterting ORFS
    f = []
    for orf in orfs:
        if orf[2] >= min_length:
            f.append(orf)
    return f


# PART 3: OUTPUT FORMATTING - Pratham Patel

def format_codons(dna):
    """Formats DNA sequence into codons (15 per line)."""
    codons = [dna[i:i+3] for i in range(0, len(dna) - 2, 3)]
    if len(dna) % 3 != 0:
        codons.append(dna[-(len(dna) % 3):])
    
    lines = []
    for i in range(0, len(codons), 15):
        lines.append(' '.join(codons[i:i+15]))
    
    return '\n'.join(lines)

def print_orf(header, frame, pos, length, seq):
    """Prints a single ORF in FASTA format."""
    print(f">{header} | FRAME = {frame} POS = {pos} LEN = {length}")
    print(format_codons(seq))
    print()

def print_all_orfs(header, orfs):
    """Prints all ORFs for a given sequence."""
    if not orfs:
        return
    for frame, pos, length, seq in orfs:
        print_orf(header, frame, pos, length, seq)

# MAIN PROGRAM

def main():
    sequences = get_sequences()
    
    if not sequences:
        return

    m = input("Enter minimum length in bp for ORFs (default=50): ")

    try:
        min_length = 50 if m.strip() == "" else int(m)
    except ValueError:
        print("Invalid input. Using default = 50.")
        min_length = 50
    
    for header, dna in sequences:
        orfs = find_orfs(dna)
        orfs = filtering (orfs, min_length)
        
        if orfs:
            orfs.sort(key=lambda x: (x[0], x[1]))
            print_all_orfs(header, orfs)
        else:
            print(f">{header} | No ORFs found\n")

if __name__ == "__main__":
    main()
