def format_sequence(d):
    codons = [d[i:i+3] for i in range(0, len(d)-2, 3)]
    lines = []

    for i in range(0, len(codons), 15):
        lines.append(' '.join(codons[i:i+15]))

    return '\n'.join(lines)

