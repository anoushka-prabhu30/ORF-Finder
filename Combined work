# PART 1: INPUT PARSING - Anoushka Prabhu


def get_input():
    f = input("Enter FASTA file: ")
    m = input("Enter minimum length in bp for ORFs (default=50): ")
    m = 50 if m.strip() == "" else int(m)
    return f, m

def parse(f):
    try:
        with open(f, 'r') as file:
            lines = file.readlines()
    except FileNotFoundError:
        print(f"Error: File '{f}' not found.")
        return []
    
    seqs = []
    i = 0
    
    while i < len(lines):
        if lines[i].startswith('>'):
            h = lines[i].strip()[1:]
            i += 1
            parts = []
            while i < len(lines) and not lines[i].startswith('>'):
                line = lines[i].strip().upper()
                line = ''.join(line.split())
                if line:
                    parts.append(line)
                i += 1
            dna = ''.join(parts)
            seqs.append((h, dna))
        else:
            i += 1
    
    return seqs

def get_sequences():
    f, m = get_input()
    seqs = parse(f)
    if not seqs:
        print("No sequences found!")
        return [], m
    print(f"\nFound {len(seqs)} sequence(s)")
    return seqs, m



# PART 2: ORF DETECTION - Ashwarya Sharma


def reverse_complement(dna):
    complement = {'A': 'T', 'T': 'A', 'G': 'C', 'C': 'G'}
    return ''.join(complement[base] for base in dna[::-1])

def find_orfs_in_frame(dna, frame, frame_num, is_reverse, min_len, original_len):
    orfs = []
    start_pos = frame
    i = start_pos
    
    while i <= len(dna) - 3:
        codon = dna[i:i+3]
        
        if codon == 'ATG':
            start_idx = i
            j = i + 3
            
            while j <= len(dna) - 3:
                stop_codon = dna[j:j+3]
                
                if stop_codon in ['TAA', 'TAG', 'TGA']:
                    orf_seq = dna[start_idx:j+3]
                    orf_len = len(orf_seq)
                    
                    if orf_len >= min_len:
                        if is_reverse:
                            pos = -(original_len - start_idx)
                        else:
                            pos = start_idx + 1
                        orfs.append((frame_num, pos, orf_len, orf_seq))
                    
                    i = j + 3
                    break
                j += 3
            else:
                break
        else:
            i += 3
    
    return orfs

def find_all_orfs(dna, min_len):
    all_orfs = []
    original_len = len(dna)
    
    for frame in range(3):
        orfs = find_orfs_in_frame(dna, frame, frame + 1, False, min_len, original_len)
        all_orfs.extend(orfs)
    
    rev_dna = reverse_complement(dna)
    
    for frame in range(3):
        orfs = find_orfs_in_frame(rev_dna, frame, frame + 4, True, min_len, original_len)
        all_orfs.extend(orfs)
    
    return all_orfs



# PART 3: OUTPUT FORMATTING - Pratham Patel


def format_codons(dna):
    codons = [dna[i:i+3] for i in range(0, len(dna) - 2, 3)]
    if len(dna) % 3 != 0:
        codons.append(dna[-(len(dna) % 3):])
    
    lines = []
    for i in range(0, len(codons), 15):
        lines.append(' '.join(codons[i:i+15]))
    
    return '\n'.join(lines)

def print_orf(header, frame, pos, length, seq):
    print(f">{header} | FRAME = {frame} POS = {pos} LEN = {length}")
    print(format_codons(seq))
    print()

def print_all_orfs(header, orfs):
    if not orfs:
        return
    for frame, pos, length, seq in orfs:
        print_orf(header, frame, pos, length, seq)



# MAIN PROGRAM

def main():
    sequences, min_length = get_sequences()
    
    if not sequences:
        return
    
    print(f"\nSearching for ORFs with minimum length {min_length} bp...\n")
    print("-" * 50)
    
    for header, dna in sequences:
        print(f"\nProcessing: {header}")
        orfs = find_all_orfs(dna, min_length)
        
        if orfs:
            orfs.sort(key=lambda x: x[0])
            print_all_orfs(header, orfs)
        else:
            print(f"No ORFs found with length >= {min_length} bp\n")

if __name__ == "__main__":
    main()
